[Unit]
Description=Bot4VPS (Web UI + Telegram bot)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bot4vps
Environment=PYTHONPATH=/opt/bot4vps
# Единый процесс: uvicorn lifespan поднимает Telegram
ExecStart=/opt/bot4vps/venv/bin/python -m uvicorn ui.web.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
# Быстрый перезапуск: не ждать завершения долгих соединений (SSE/WebSocket)
TimeoutStopSec=3
KillMode=mixed

# Старые раздельные юниты отключить:
#   systemctl disable --now bot4vps.service bot4vps-web.service

[Install]
WantedBy=multi-user.target
