#!/bin/sh /etc/rc.common
# Bot4VPS managed GitHub installation. DNS/DHCP changes are separate operations.
START=95
STOP=10
USE_PROCD=1
ROOT=/opt/AdGuardHome
start_service() {
    [ -x "$ROOT/AdGuardHome" ] || return 1
    mkdir -p "$ROOT/work"
    chmod 700 "$ROOT" "$ROOT/work"
    procd_open_instance
    if [ -s "$ROOT/AdGuardHome.yaml" ]; then
        procd_set_param command "$ROOT/AdGuardHome" --no-check-update -c "$ROOT/AdGuardHome.yaml" -w "$ROOT/work"
    else
        procd_set_param command "$ROOT/AdGuardHome" --no-check-update -c "$ROOT/AdGuardHome.yaml" -w "$ROOT/work" -h BIND_ADDRESS -p 3000
    fi
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
