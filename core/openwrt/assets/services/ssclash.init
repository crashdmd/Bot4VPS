#!/bin/sh /etc/rc.common
# SSClash-Go — procd service for the single-binary daemon.
# Bot4VPS SSClash web access

USE_PROCD=1
START=21
STOP=79

ROOT=/opt/clash
PROG="$ROOT/bin/ssclash"
PIDFILE=/var/run/ssclash.pid
TLS_CERT="$ROOT/.ssclash/tls.crt"
TLS_KEY="$ROOT/.ssclash/tls.key"

start_service() {
	config_load ssclash
	config_get web_scope main web_scope lan
	config_get web_port main web_port 9091
	case "$web_port" in ''|*[!0-9]*) web_port=9091;; esac
	[ "$web_port" -ge 1 ] && [ "$web_port" -le 65535 ] || web_port=9091
	if [ "$web_scope" = wan ]; then
		web_addr=":$web_port"
	else
		web_scope=lan
		lan_address=$(uci -q get network.lan.ipaddr)
		lan_address=${lan_address%% *}
		lan_address=${lan_address%%/*}
		if [ -z "$lan_address" ]; then
			lan_address=$(ucode -e 'import {connect} from "ubus"; let state=connect().call("network.interface.lan","status",{})||{}; let addresses=state["ipv4-address"]||[]; if(length(addresses))print(addresses[0].address||"");' 2>/dev/null)
		fi
		case "$lan_address" in ''|*[!0-9.]*) lan_address=127.0.0.1;; esac
		web_addr="$lan_address:$web_port"
	fi
	procd_open_instance ssclash
	procd_set_param command "$PROG" serve
	procd_set_param env SSCLASH_ROOT="$ROOT" SSCLASH_ADDR="$web_addr" SSCLASH_SCOPE="$web_scope"
	# LAN is the default. Listening on WAN requires an explicitly confirmed plan.
	# HTTPS web UI — uncomment after placing cert/key (see install script / README):
	# procd_append_param env SSCLASH_TLS_CERT="$TLS_CERT" SSCLASH_TLS_KEY="$TLS_KEY"
	procd_set_param respawn 3600 5 0
	# Avoid EMFILE under dead-proxy/DNS connection storms (default soft nofile is often 1024).
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "$PIDFILE"
	procd_close_instance
}

_wait_ssclash() {
	[ -f "$PIDFILE" ] || return 0
	pid=$(cat "$PIDFILE" 2>/dev/null) || return 0
	[ -n "$pid" ] || return 0
	i=0
	while [ "$i" -lt 10 ]; do
		kill -0 "$pid" 2>/dev/null || return 0
		i=$((i + 1))
		sleep 1
	done
}

stop() {
	procd_kill "${basescript:-$initscript}" "$1"
	_wait_ssclash
	"$PROG" cleanup 2>/dev/null || true
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "network"
	procd_add_interface_trigger "interface.*" "lan" /etc/init.d/ssclash reload
}
