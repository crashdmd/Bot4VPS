}
function revoke_sessions(username) {
    // The shell exits immediately; session API calls happen in a separate process.
    let child = popen('(sleep 1; /usr/bin/ucode /usr/libexec/bot4vps-revoke.uc ' + quote(username) + ') >/dev/null 2>&1 &');
    if (child) child.close();
}
function change(request, rotate) {
    let id = request.args.id;
    if (!match(id || '', /^bot4vps_[a-f0-9]+$/)) return { error: 'Invalid account' };
    let c = cursor();
    if (!c.get('rpcd', id, 'bot4vps_id')) return { error: 'Unknown account' };
    let username = 'bot4vps_' + c.get('rpcd', id, 'bot4vps_id');
    let secret = null;
    if (rotate) {
        let f = open('/dev/urandom', 'r');
        if (!f) return { error: 'Random source unavailable' };
        secret = hexenc(f.read(32));
        f.close();
        let hash = popen('/usr/sbin/uhttpd -m ' + quote(secret));
        let password = hash ? trim(hash.read('all')) : '';
        if (hash) hash.close();
        if (!length(password)) return { error: 'Password hashing failed' };
        c.set('rpcd', id, 'password', password);
    }
    else {
        let enabled = request.args.enabled;
        c.set('rpcd', id, 'bot4vps_disabled', enabled ? '0' : '1');
        c.set('rpcd', id, 'username', enabled ? username : '__disabled__' + username);
    }
    if (!c.commit('rpcd')) return { error: 'Cannot save account' };
    revoke_sessions(username);
    return { ok: true, secret, username };
}
function disconnect(username) {
    // Account is captured from the object definition, not supplied by the caller.
    // Each account has an ACL for its own bot4vps-key-<id> object only.
    let c = cursor();
    if (!c.get('rpcd', username, 'bot4vps_id')) return { error: 'Not a managed account' };
    c.delete('rpcd', username);
    if (!c.commit('rpcd')) return { error: 'Cannot revoke account' };
    unlink('/etc/bot4vps/keys/' + username + '.pub');
    unlink('/usr/share/rpcd/acl.d/bot4vps-key-' + substr(username, 8) + '.json');
    revoke_sessions(username);
    return { revoked: true };
}

function job_directory(username, nonce) {
    if (!match(nonce || '', /^[a-f0-9]{32}$/)) return null;
    return '/tmp/bot4vps-jobs/' + username + '/' + nonce;
}
function digest(path) {
    let fd = popen('sha256sum ' + quote(path) + ' 2>/dev/null');
    let data = fd ? fd.read('all') : '';
    if (fd) fd.close();
    return split(trim(data), ' ')[0] || '';
}
function package_fingerprint(manager) {
    if (manager != 'apk') return digest('/usr/lib/opkg/status');
    let p = popen('apk list -I --manifest 2>/dev/null | sort | sha256sum');
    let text = p ? p.read('all') : '';
    if (p) p.close();
    return split(trim(text), ' ')[0] || '';
}
function collect_jobs(username) {
    for (let dir in glob('/tmp/bot4vps-jobs/' + username + '/*')) {
        let nonce = split(dir, '/')[4];
        if (!match(nonce, /^[a-f0-9]{32}$/)) continue;
        let path = dir + '/state.json', state;
        try { state = json(readfile(path) || '{}'); } catch (error) { state = {}; }
        if (state.phase == 'running' || state.phase == 'verify') continue;
        if (time() - (stat(path)?.mtime || stat(dir)?.mtime || time()) < 900) continue;
        let p = popen('rm -rf ' + quote(dir)); if (p) p.close();
        connect().call('service', 'delete', { name: 'bot4vps-job-' + nonce });
    }
    if (length(glob('/tmp/bot4vps-jobs/' + username + '/*')) >= 16) die('Слишком много незавершённых планов. Завершите или очистите старые операции.');
}
function store_plan(username, nonce, plan) {
    let dir = job_directory(username, nonce);
    if (!dir) return { error: 'Некорректный идентификатор' };
    mkdir('/tmp/bot4vps-jobs', 0700); mkdir('/tmp/bot4vps-jobs/' + username, 0700);
    for (let path in glob('/tmp/bot4vps-jobs/' + username + '/*/state.json')) {
        let old = json(readfile(path) || '{}');
        if (old.phase != 'running' && old.phase != 'verify' && time() - (stat(path)?.mtime || time()) > 900) {
            let old_nonce = split(path, '/')[4];
            if (match(old_nonce, /^[a-f0-9]{32}$/)) {
                let child = popen('rm -rf ' + quote('/tmp/bot4vps-jobs/' + username + '/' + old_nonce));
                if (child) child.close();
            }
        }
    }
    if (length(glob('/tmp/bot4vps-jobs/' + username + '/*/state.json')) >= 16)
        return { error: 'Слишком много незавершённых планов. Завершите или очистите старые операции.' };
    mkdir(dir, 0700);
    if (access(dir + '/state.json')) return { error: 'Операция уже существует' };
    put_file(dir + '/plan.json', sprintf('%J', plan), 0600);
