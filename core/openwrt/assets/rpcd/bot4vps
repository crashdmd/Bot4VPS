function put_file(path, data, mode) {
    let file = open(path, 'w', mode == null ? 0600 : mode);
    if (!file) die('Не удалось сохранить файл операции');
    file.write(data);
    file.close();
}

function quote(s) { return "'" + replace(s, "'", "'\\''") + "'"; }
function package_feed(line) {
    let fields = split(trim(split(line || '', '#')[0]), /\s+/);
    let url = fields[0] || '';
    if (substr(url, 0, 1) == '@') url = fields[1] || '';
    if (match(url, /^http:\/\/downloads\.openwrt\.org\//))
        url = 'https://' + substr(url, 7);
    return match(url, /^https:\/\/downloads\.openwrt\.org\//) ? url : null;
}
function packages() {
    let fd = popen(access('/sbin/apk') || access('/usr/bin/apk') ? 'apk list -I --manifest 2>/dev/null' : 'opkg list-installed 2>/dev/null');
    let text = fd ? fd.read('all') : '';
    if (fd) fd.close();
    let manager = access('/sbin/apk') || access('/usr/bin/apk') ? 'apk' : 'opkg';
    if (manager == 'apk') {
        let normalized = [];
        for (let line in split(text, '\n')) {
            let fields = split(trim(line), /\s+/);
            if (length(fields) == 2) push(normalized, fields[0] + ' - ' + fields[1]);
        }
        text = join('\n', normalized);
    }
    let arch = '';
    let fdarch = popen(manager == 'opkg' ? 'opkg print-architecture' : 'apk --print-arch');
    let archtext = fdarch ? fdarch.read('all') : '';
    if (fdarch) fdarch.close();
    if (manager == 'opkg') {
        let priority = -1;
        for (let line in split(archtext, '\n')) {
            let fields = split(trim(line), /\s+/);
            if (length(fields) == 3 && int(fields[2]) > priority) { arch = fields[1]; priority = int(fields[2]); }
        }
    } else arch = trim(archtext);
    let kernel = null;
    for (let line in split(text, '\n')) {
        let found = match(line, /^kernel - (.+)$/);
        if (found) kernel = found[1];
    }
    let feeds = [];
    if (manager == 'opkg') {
        for (let path in glob('/etc/opkg/*feeds.conf'))
            for (let line in split(readfile(path) || '', '\n')) {
                let fields = split(trim(line), /\s+/);
                let url = length(fields) >= 3 && fields[0] == 'src/gz' ? package_feed(fields[2]) : null;
                if (url) push(feeds, url);
            }
    } else {
        for (let path in ['/etc/apk/repositories', ...glob('/etc/apk/repositories.d/*')])
            for (let line in split(readfile(path) || '', '\n')) {
                let url = package_feed(line);
                if (url) push(feeds, url);
            }
    }
    let apk_keys = [];
    if (manager == 'apk')
        for (let path in [...glob('/etc/apk/keys/*.pub'), ...glob('/etc/apk/keys/*.pem')]) {
            if ((stat(path)?.size || 0) > 16384) continue;
            let resolved = realpath(path);
            let data = readfile(path);
            if (!resolved || substr(resolved, 0, 14) != '/etc/apk/keys/' || index(data || '', 'PUBLIC KEY') < 0 || index(data || '', 'PRIVATE KEY') >= 0) continue;
            let fields = split(path, '/');
            push(apk_keys, { name: fields[length(fields) - 1], data });
        }
    return { manager, output: text, architecture: arch, kernel, feeds, apk_keys };
}
function wireguard() {
    if (!access('/usr/bin/wg')) return null;
    let p = popen('/usr/bin/wg show all dump 2>/dev/null');
    let output = p ? p.read('all') : '';
    if (p) p.close();
    let interfaces = {};
    for (let line in split(output, '\n')) {
        let fields = split(trim(line), /\s+/);
        if (length(fields) == 5) interfaces[fields[0]] = { name: fields[0], listen_port: int(fields[3]), peers: [] };
        else if (length(fields) >= 9 && interfaces[fields[0]]) {
            let last_handshake = int(fields[5]);
            push(interfaces[fields[0]].peers, { endpoint: fields[3], allowed_ips: split(fields[4], ','),
                last_handshake, recent_handshake: last_handshake > 0 && time() - last_handshake < 180,
                rx_bytes: int(fields[6]), tx_bytes: int(fields[7]) });
        }
    }
    return interfaces;
}
function status() {
    let bus = connect();
    let all = bus ? bus.call('service', 'list', {}) : {};
    let services = {};
    for (let name in ['dnsmasq', 'firewall', 'podkop', 'ssclash', 'adguardhome']) {
        let installed = access('/etc/init.d/' + name);
        let running = false;
        for (let key, instance in (all?.[name]?.instances || {}))
            if (instance.running) running = true;
        let kind = name == 'firewall' ? 'rules' : 'process';
        if (name == 'firewall' && installed) {
            let fw = popen('nft list table inet fw4 >/dev/null 2>&1');
            running = fw && fw.close() == 0;
        }
        services[name] = { installed: !!installed, running: !!running, kind };
        if (name == 'adguardhome' && installed) { let info = agh.information(); services[name].web_port = info.web_port; services[name].web_https = false; services[name].managed = info.managed; }
        if (name == 'ssclash' && installed) {
            let port = 9091, https = false;
            services[name].managed = index(readfile('/etc/init.d/ssclash') || '', '# Bot4VPS SSClash web access') >= 0;
            services[name].web_scope = cursor().get('ssclash', 'main', 'web_scope') || 'lan';
            for (let key, instance in (all?.[name]?.instances || {})) {
                let env = instance.env || {};
                let found = match(env.SSCLASH_ADDR || ':9091', /:([0-9]+)$/);
                if (found && int(found[1]) >= 1 && int(found[1]) <= 65535) port = int(found[1]);
                if (index(['lan', 'wan'], env.SSCLASH_SCOPE) >= 0) services[name].web_scope = env.SSCLASH_SCOPE;
                if (env.SSCLASH_TLS_CERT && env.SSCLASH_TLS_KEY) https = true;
            }
            services[name].web_port = port;
            services[name].web_https = https;
        }
    }
