function router_plan(username, request) {
    let nonce = request.args.nonce;
    collect_jobs(username);
    let dir = job_directory(username, nonce);
    if (!dir || access(dir)) return { error: 'Некорректный или уже использованный идентификатор' };
    if (length(request.args.data || '') > 49152) return { error: 'Сетевой план слишком большой' };
    let data = json(request.args.data || '{}');
    mkdir('/tmp/bot4vps-jobs', 0700); mkdir('/tmp/bot4vps-jobs/' + username, 0700); mkdir(dir, 0700);
    try {
        let plan;
        if (request.args.kind == 'network') plan = net.prepare(dir, request.args.action, data);
        else if (request.args.kind == 'packages') plan = pm.prepare(request.args.action, data);
        else if (request.args.kind == 'backup') plan = backup.prepare(request.args.action, data);
        else die('Тип операции не поддерживается');
        plan.nonce = nonce;
        return store_plan(username, nonce, plan);
    } catch (error) {
        put_file(dir + '/state.json', sprintf('%J', { phase: 'failed', updated_at: time() }), 0600);
        let child = popen('rm -rf ' + quote(dir));
        if (child) child.close();
        die(type(error) == 'object' ? error.message : '' + error);
    }
}
function service_versions() {
