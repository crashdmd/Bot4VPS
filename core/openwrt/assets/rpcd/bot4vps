    for (let path in [...glob('/sys/class/thermal/thermal_zone*/temp'), ...glob('/sys/class/hwmon/hwmon*/temp*_input')]) {
        let value = int(trim(readfile(path) || ''));
        if (value > 0 && value < 200000) {
            temperature = value / 1000;
            break;
        }
    }
    let model = readfile('/sys/class/dmi/id/product_name') || '';
    let cpu = readfile('/proc/cpuinfo') || '';
    let virtual = match(model, /(QEMU|Virtual|VMware|KVM|Hyper-V)/i) || match(cpu, /hypervisor/);
    let sensor_package = null;
    if (temperature == null && !virtual) {
        if (index(cpu,'GenuineIntel') >= 0) sensor_package = 'kmod-hwmon-coretemp';
        else if (index(cpu,'AuthenticAMD') >= 0) sensor_package = 'kmod-hwmon-k10temp';
    }
