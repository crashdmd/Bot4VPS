}
function accounts() {
    let c = cursor();
    let result = [];
    c.foreach('rpcd', 'login', function(s) {
        if (s.bot4vps_id && match(s['.name'], /^bot4vps_[a-f0-9]+$/))
            push(result, { id: s['.name'], username: 'bot4vps_' + s.bot4vps_id,
                label: s.bot4vps_label || 'Bot4VPS', enabled: s.bot4vps_disabled != '1' });
    });
