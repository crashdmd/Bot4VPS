
# --------------------------------------------------
# Python
# --------------------------------------------------

# Скомпилированные файлы Python
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
venv/
.env/
.venv/

# --------------------------------------------------
# Конфигурация
# --------------------------------------------------

# Основной файл конфигурации (содержит секреты)
config.json

# --------------------------------------------------
# Пользовательские данные (не входят в репозиторий)
# --------------------------------------------------
# Зарегистрированные серверы
servers.json

# Состояние мониторинга
monitor.json

# SSH-ключи пользователя
keys/

# Пользовательские скрипты
scripts/

# Резервные копии
/backup/

# Рабочие данные
data/

# Журналы
logs/
*.log

# --------------------------------------------------
# Среды разработки
# --------------------------------------------------

.idea/
.vscode/
*.swp
*.code-workspace
# Runtime lock files
*.json.lock

# Локальная среда и архивы
/.local-build/
/.local-archives/

