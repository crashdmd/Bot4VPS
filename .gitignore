
# --------------------------------------------------
# Python
# --------------------------------------------------

# Скомпилированные файлы Python
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
venv/
.env/
.venv/

# --------------------------------------------------
# Конфигурация и данные (ТОЛЬКО в корне проекта — ведущий слэш,
# иначе правило съедает одноимённые каталоги кода: так было
# потеряно core/backup/)
# --------------------------------------------------

# Основной файл конфигурации (содержит секреты)
/config.json

# Зарегистрированные серверы
/servers.json

# Состояние мониторинга
/monitor.json

# Побочные файлы runtime JSON: резервные копии, quarantine и временные файлы
/config.json.*
/servers.json.*
/monitor.json.*

# Sidecar locks for runtime JSON stores
/config.json.lock
/servers.json.lock
/monitor.json.lock

# SSH-ключи пользователя
/keys/

# Пользовательские скрипты
/scripts/

# Резервные копии (архивы)
/backup/

# Рабочие данные
/data/

# Журналы
/logs/
*.log

# --------------------------------------------------
# Среды разработки
# --------------------------------------------------

.idea/
.vscode/
*.swp
*.code-workspace

# Локальные инструменты
.pytest_cache/

# Рантайм-состояние: БД метрик и аудита (data/state.db), кэши сервисов,
# состояние Telegram, каталоги обновления. В репозитории ему делать нечего —
# оно у каждой машины своё и восстанавливается из бэкапа панели.

# Локальные архивы и среды сборки, не входят в релиз
/.local-archives/
/.local-build/
